DATABASE_URL=
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required in every mode. Accepts either the server URL or a URL ending in /api/v1.
HEADSCALE_API_URL=
HEADSCALE_API_KEY=

# Optional deployment subpath, for example /panel. Leave empty for root deployment.
HEADPANEL_BASE_PATH=

# Optional. ACL policy file that group rules are merged into, so hand-written
# rules survive. Defaults to /etc/headpanel/policy-baseline.json.
HEADPANEL_POLICY_BASELINE=

# Optional. Headscale's SQLite file, read to show each node's LAN address.
# Only usable when the panel runs on the Headscale host; falls back to the path
# in HEADSCALE_CONFIG_PATH, then to /var/lib/headscale/db.sqlite.
HEADSCALE_DB_PATH=

# Optional host control. Keep false for a remote/API-only Headscale instance.
HEADSCALE_HOST_CONTROL=false
HEADSCALE_CONFIG_PATH=
HEADSCALE_BIN=
SYSTEMCTL_BIN=
